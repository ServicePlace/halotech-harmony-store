{
  "name": "halotech-harmony-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "bun:build": "bun run tsc && bun run vite build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "azure-build": "npm run build",
    "azure-deploy": "npm run build && az staticwebapp deploy --source dist",
    "build:prod": "cross-env NODE_ENV=production vite build",
    "build:dev": "cross-env NODE_ENV=development vite build",
    "start": "vite preview --port 3000",
    "serve": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clerk/clerk-react": "^4.0.0",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@solana/web3.js": "^1.87.0",
    "class-variance-authority": "^1.0.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.0.0",
    "embla-carousel-react": "^7.0.0",
    "framer-motion": "^10.0.0",
    "input-otp": "^1.0.0",
    "lovable-tagger": "^1.1.8",
    "lucide-react": "^0.244.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-day-picker": "^8.0.0",
    "react-resizable-panels": "^2.0.9",
    "react-router-dom": "^6.0.0",
    "recharts": "^2.0.0",
    "sonner": "^1.3.1",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.0.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.8.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@types/react-router-dom": "^6.0.0",
    "@types/react-day-picker": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.54.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.0.0",
    "vite": "^5.0.2"
  }
}
